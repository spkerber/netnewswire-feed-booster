# Copy this file to data/private.env or data/private-modal.env.
# Choose one host provider section. The RSS_* settings are provider-neutral.

# Core reader/export settings.
RSS_PROFILE=me
RSS_SOURCES_FILE=data/sources.json
RSS_HISTORY_FILE=data/subscription-history.json
RSS_FEED_TOKEN=replace-with-a-long-random-token
RSS_FEED_BASE=https://your-rss-bridge.example.com
FULL_FAN_SOURCE_IDS=
NETNEWSWIRE_OPML_OUT=exports/me-netnewswire-hosted.opml

# Optional: override if your NetNewsWire account path differs from the default iCloud path.
# NETNEWSWIRE_OPML="$HOME/Library/Containers/com.ranchero.NetNewsWire-Evergreen/Data/Library/Application Support/NetNewsWire/Accounts/2_iCloud/Subscriptions.opml"

# Host provider: Modal.
# Use this section with scripts/netnewswire_workflow.sh deploy-modal.
MODAL_APP_NAME=rss-feed-bridge
MODAL_SECRET_NAME=rss-feed-bridge-token
MODAL_VOLUME_NAME=rss-feed-bridge-cache

# Host provider: Railway.
# Configure equivalent service variables in Railway's dashboard or CLI.
# RAILWAY_SERVICE_NAME=rss-feed-bridge

# Host provider: DigitalOcean.
# Configure equivalent App Platform or Droplet environment variables there.
# DIGITALOCEAN_APP_NAME=rss-feed-bridge

# Host provider: Cloudflare Workers.
# A Workers implementation is not included yet; use RSS_FEED_BASE/RSS_FEED_TOKEN
# with Worker secrets/KV/R2 when that serving path exists.
# CLOUDFLARE_WORKER_NAME=rss-feed-bridge
